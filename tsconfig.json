{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "outDir": "dist",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["esnext", "dom", "webworker",],
    "types": ["@webgpu/types"]
  },
  "include": ["src"]
}
